{
  "name": "@fundkit/ui",
  "version": "0.8.0",
  "description": "FundKit design system \u2014 shared admin UI components, tokens, and widgets.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fundkitorg/ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./components/*": "./dist/components/*.js",
    "./widgets/*": "./dist/widgets/*.js",
    "./styling/*": "./dist/styling/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./scss/tokens": "./src/scss/_tokens.scss",
    "./scss/index": "./src/scss/index.scss",
    "./scss/components/*": "./src/scss/components/_*.scss",
    "./scss/admin-base": "./src/scss/_admin-base.scss",
    "./scss/dataviews": "./src/scss/_dataviews.scss",
    "./scss/kpi-strip": "./src/scss/_kpi-strip.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/scss"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "build": "babel src --out-dir dist --extensions .js,.jsx --ignore \"src/**/*.stories.jsx\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@dnd-kit/core": ">=6",
    "@dnd-kit/sortable": ">=10",
    "@dnd-kit/utilities": ">=3",
    "@wordpress/components": ">=28",
    "@wordpress/date": ">=5",
    "@wordpress/element": ">=6",
    "@wordpress/i18n": ">=5",
    "@wordpress/icons": ">=10",
    "lucide-react": ">=1.16",
    "recharts": ">=3"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@wordpress/babel-preset-default": "^8.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/date": "^5.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/eslint-plugin": "^22.22.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/icons": "^10.0.0",
    "eslint": "^8.57.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.8.1",
    "sass": "^1.80.0",
    "storybook": "^8.4.0",
    "vite": "^5.4.0"
  }
}
